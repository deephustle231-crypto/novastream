rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'deephustle231@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isOwner(userId) &&
        incoming().keys().hasAll(['email', 'role', 'plan']) &&
        incoming().role == 'user' && // Never allow client self-assignment of admin
        incoming().plan == 'free';
      allow update: if (
        isAdmin() ||
        (isOwner(userId) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatar', 'updatedAt']) &&
         (!('displayName' in incoming()) || (incoming().displayName is string && incoming().displayName.size() <= 100)) &&
         (!('avatar' in incoming()) || (incoming().avatar is string && incoming().avatar.size() <= 500)))
      );
      allow delete: if isAdmin();
    }

    // Movies Collection
    match /movies/{movieId} {
      allow get, list: if true; // Public catalog viewing
      allow create, update, delete: if isAdmin();
    }

    // Series Collection
    match /series/{seriesId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Episodes Collection
    match /episodes/{episodeId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Watchlist Collection
    match /watchlist/{watchlistId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid &&
        incoming().keys().hasAll(['userId', 'mediaId', 'mediaType', 'title']) &&
        incoming().title is string && incoming().title.size() <= 200;
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // Watch Progress Collection
    match /watchProgress/{progressId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid &&
        incoming().keys().hasAll(['userId', 'mediaId', 'positionSeconds', 'durationSeconds']) &&
        incoming().positionSeconds is number && incoming().durationSeconds is number;
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Payments Collection (Created only through server-side verified actions or Admin)
    match /payments/{paymentId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Subscriptions Collection
    match /subscriptions/{subId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Audit Logs (Strict Admin-Only)
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
